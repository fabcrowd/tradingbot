# ── Environment / Secrets ──
# .env is tracked intentionally (private repo) — keep *.env.local out of git
*.env.local

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# ── Node ──
node_modules/
.npm/
.pnp.*

# ── IDE ──
# Cursor: track portable project assets; ignore everything else under .cursor/
.cursor/**
!.cursor/README.md
!.cursor/skills/
!.cursor/skills/**
!.cursor/rules/
!.cursor/rules/**
!.cursor/agents/
!.cursor/agents/**
!.cursor/references/
!.cursor/references/**
.claude/
.vscode/
*.swp
*.swo
*~

# ── Task / Plan files ──
tasks/
*.plan.md

# Runtime data under data/, bots/, and research/ is tracked (operator archive).
# Files over GitHub's 100MB blob limit go through Git LFS (.gitattributes).

# ── Debug / Temp ──
debug-*.log
*.log
!data/*.log
!data/**/*.log
tmp_*.html

# ── Research generated data ──
research/polymarket_backtests/__pycache__/

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Lessons (auto-generated) ──
lessons.md
lessons
